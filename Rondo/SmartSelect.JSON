{
  "Name": "SmartSelectOCR",
  "Commands": [
    {
      "Command": "store",
      "Target": "[\"Březovník obecný\",\"Uherský Brod\",\"Pavel Bolf\",\"Lanzarote\",\"Smetana ke šlehání\",\"Česká Lípa\",\"Kmín\",\"3%\",\"Perlová bylina\",\"Listopad\",\"Bílý\",\"Vývar\",\"Sádlo\"]",
      "Value": "myList"
    },

    {
      "Command": "visionFind",
      "Target": "answer_area.png",
      "Value": "answerArea"
    },

    {
      "Command": "ocrExtractRelative",
      "Target": "answerArea",
      "Value": "ocrText"
    },

    {
      "Command": "executeScript_Sandbox",
      "Target": "var list = JSON.parse(${myList}); var txt = ${ocrText}; var lines = txt.split('\\n'); for(var i=0;i<lines.length;i++){ if(list.includes(lines[i].trim())) return i; } return -1;",
      "Value": "matchIndex"
    },

    {
      "Command": "if",
      "Target": "${matchIndex} >= 0",
      "Value": ""
    },
    {
      "Command": "visionClickRelative",
      "Target": "answerArea",
      "Value": "${matchIndex}"
    },
    {
      "Command": "else"
    },
    {
      "Command": "visionClickRelative",
      "Target": "answerArea",
      "Value": "0"
    },
    {
      "Command": "endif"
    }
  ]
}
